rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 헬퍼: 인증 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 기업별 심사 파일 경로: audit_files/{companyId}/{fileName}
    match /audit_files/{companyId}/{fileName} {
      allow read: if true; // 브라우저 PDF 리더 및 다운로드 지원
      allow write: if isAuthenticated();
    }

    // 공용 문서 템플릿: public_templates/{allPaths=**}
    match /public_templates/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // 전체 하위 경로 보안 규칙 (폴백)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
