rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 헬퍼: 인증 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 테넌트별 심사 파일 경로: audit_files/{tenantId}/{companyId}/{fileName}
    match /audit_files/{tenantId}/{companyId}/{fileName} {
      // 인증된 사용자이며 해당 테넌트 소속일 때 접근 허용
      allow read: if isAuthenticated() && request.auth.token.tenantId == tenantId;
      allow write: if isAuthenticated() && request.auth.token.tenantId == tenantId;
    }

    // 공용 문서 템플릿: public_templates/{allPaths=**}
    match /public_templates/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }
  }
}
