rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 헬퍼 함수: 인증 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // 헬퍼 함수: 사무국 관리자 여부 확인
    function isSecretariatAdmin(tenantId) {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || request.auth.token.affiliation == '상근') &&
        request.auth.token.tenantId == tenantId;
    }
    
    // 헬퍼 함수: 배정된 심사원 여부 확인
    function isAssignedAuditor(resourceData) {
      return isAuthenticated() && 
        (request.auth.uid == resourceData.auditorId || 
         request.auth.token.name == resourceData.auditorName ||
         request.auth.token.email == resourceData.auditorEmail);
    }
    
    // [1. 멀티테넌트 플랫폼 설정 및 라이선스 컬렉션] - 슈퍼 관리자 전용
    match /platform_tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    // [2. 심사 문서 및 보고서 메타데이터 컬렉션] - 테넌트 격리 및 심사원별 보안
    match /audit_documents/{docId} {
      // 사무국 관리자는 소속 테넌트의 모든 문서 조회 가능
      // 일반 심사원은 자신이 배정된 문서만 조회 가능
      allow read: if isAuthenticated() && (
        isSecretariatAdmin(resource.data.tenantId) || 
        isAssignedAuditor(resource.data)
      );
      
      // 쓰기/수정: 사무국 또는 해당 배정 심사원
      allow write: if isAuthenticated() && (
        isSecretariatAdmin(request.resource.data.tenantId) ||
        isAssignedAuditor(request.resource.data)
      );
    }

    // [3. 심사 프로젝트 컬렉션]
    match /audit_projects/{projectId} {
      allow read: if isAuthenticated() && (
        isSecretariatAdmin(resource.data.tenantId) ||
        request.auth.uid == resource.data.leadAuditorId ||
        request.auth.token.name in resource.data.teamAuditorNames
      );
      allow write: if isSecretariatAdmin(request.resource.data.tenantId);
    }

    // [4. 심사원 명단 컬렉션]
    match /auditors/{auditorId} {
      // 상근 사무국은 전체 조회 가능, 비상근 심사원은 본인 프로필만 조회
      allow read: if isAuthenticated() && (
        request.auth.token.affiliation == '상근' || 
        request.auth.uid == auditorId
      );
      allow write: if isAuthenticated() && (
        request.auth.token.affiliation == '상근' || 
        request.auth.uid == auditorId
      );
    }

    // [5. 기업 정보 컬렉션]
    match /companies/{companyId} {
      allow read, write: if isAuthenticated();
    }
  }
}
